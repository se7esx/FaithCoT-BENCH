# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# OpenAI API key (for GPT pipelines)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (for Gemini pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace token (for gated models like LLaMA)
HF_TOKEN=your_huggingface_token_here

# Path to local HLE-BIO dataset CSV (only needed for HLE_BIO dataset)
HLE_BIO_PATH=/path/to/HLE_BIO.csv
